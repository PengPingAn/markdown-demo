{
  "extends": "./tsconfig.app.json",
  "include": ["env.d.ts", "src/lib/**/*", "src/components/**/*", "src/composables/**/*", "src/plugins/**/*", "src/stores/**/*", "src/assets/**/*"],
  "exclude": ["src/**/__tests__/*", "src/main.ts", "src/router/**/*", "src/views/**/*"],
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "./dist/lib",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  }
}
