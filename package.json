{
  "name": "render-md",
  "version": "0.1.0",
  "description": "A reusable Vue 3 markdown renderer with custom markdown-it plugins and demo app.",
  "type": "module",
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./style.css": "./dist/lib/style.css"
  },
  "files": [
    "dist/lib",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.vue"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build-only && npm run build:lib",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:lib": "npm run build:lib:bundle && npm run build:lib:types",
    "build:lib:bundle": "vite build --config vite.lib.config.ts",
    "build:lib:types": "node scripts/build-lib-types.mjs",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@shikijs/markdown-it": "^4.0.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/vue-table": "^8.21.3",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.3",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "markdown-it-container": "^4.0.0",
    "pinia": "^3.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rough-notation": "^0.5.1",
    "sass-embedded": "^1.98.0",
    "scss": "^0.2.4",
    "shiki": "^4.0.2",
    "tailwind": "^4.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.35.0",
    "oxlint": "~1.50.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue": "^3.5.29",
    "vue-tsc": "^3.2.5"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
